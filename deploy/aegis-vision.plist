<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aegis.vision</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>cd /usr/local/aegis &amp;&amp; uv run main.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/usr/local/aegis/data/aegis.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/aegis/data/aegis.err</string>

    <!-- Camera + microphone access for the macOS webcam -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>OPENCV_AVFOUNDATION_SKIP_AUTH</key>
        <string>1</string>
    </dict>
</dict>
</plist>
